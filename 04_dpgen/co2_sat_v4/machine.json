                "group_size": 50,
                "queue_name": "all.q",
                "custom_flags": [
                    "#$ -l node_q=1",
                    "#$ -l h_rt=2:00:00"
                ],
                "source_list": [
                    "/gs/fs/tga-harada/Moin/deepmd/scripts/env_cp2k.sh"
                ],
                "kwargs": {
