&GLOBAL
  PROJECT dp_label
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME /home/3/uh03203/Documents/cp2k/data/BASIS_MOLOPT_UCL
    BASIS_SET_FILE_NAME /home/3/uh03203/Documents/cp2k/data/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /home/3/uh03203/Documents/cp2k/data/GTH_POTENTIALS
    MULTIPLICITY 1

    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
      ADDED_MOS 100

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        BETA 1.5
      &END MIXING

      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 1000
      &END SMEAR

      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME /home/3/uh03203/Documents/cp2k/data/dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 15
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      ABC
    &END CELL

    &COORD
      @INCLUDE coord.xyz
    &END COORD

    &KIND B
      ELEMENT B
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE
    &END KIND

    &KIND C
      ELEMENT C
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND

    &KIND Na
      ELEMENT Na
      BASIS_SET DZVP-MOLOPT-SR-GTH-q9
      POTENTIAL GTH-PBE
    &END KIND

    &KIND Li
      ELEMENT Li
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS

  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
