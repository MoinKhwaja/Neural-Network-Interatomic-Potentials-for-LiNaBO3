# Ion diffusivity via MSD at 800C (873K)
# Li15Na15(BO3)10, 2x2x5 supercell (1400 atoms)
# NVT production with MSD tracking for each species

variable        TEMP equal 1073.0
variable        PRES equal 1.0

units           metal
boundary        p p p
atom_style      atomic
neighbor        1.0 bin

box             tilt large
read_data       conf.lmp
replicate       2 2 5
change_box      all triclinic

mass            1 10.810    # B
mass            2 16.000    # O
mass            3 6.940     # Li
mass            4 22.990    # Na

pair_style      deepmd frozen_model.pb
pair_coeff      * *

velocity        all create ${TEMP} 13579

# Define groups for each species
group           grp_B   type 1
group           grp_O   type 2
group           grp_Li  type 3
group           grp_Na  type 4

# --- Phase 1: NPT equilibration (100 ps) ---
fix             1 all npt temp ${TEMP} ${TEMP} 0.1 iso ${PRES} ${PRES} 0.5
thermo_style    custom step temp pe ke etotal press vol lx ly lz
thermo          1000
timestep        0.001
run             100000
unfix           1

# --- Phase 2: NVT equilibration (50 ps) ---
fix             1 all nvt temp ${TEMP} ${TEMP} 0.1
run             50000
unfix           1

# --- Phase 3: NVT production with MSD (5 ns) ---
reset_timestep  0

fix             1 all nvt temp ${TEMP} ${TEMP} 0.1

# Compute MSD for each species (uses unwrapped coordinates automatically)
compute         msd_B   grp_B  msd
compute         msd_O   grp_O  msd
compute         msd_Li  grp_Li msd
compute         msd_Na  grp_Na msd

# Output MSD every 1000 steps (1 ps)
fix             msd_out all ave/time 1 1 1000 &
                c_msd_B[4] c_msd_O[4] c_msd_Li[4] c_msd_Na[4] &
                file msd.dat title1 "# Step MSD_B MSD_O MSD_Li MSD_Na (Ang^2)"

thermo_style    custom step temp pe ke etotal press &
                c_msd_B[4] c_msd_O[4] c_msd_Li[4] c_msd_Na[4]
thermo          10000

# Dump unwrapped coordinates for multi-origin MSD post-processing
dump            1 all custom 1000 traj_unwrap.lammpstrj id type xu yu zu
dump_modify     1 sort id

run             5000000
