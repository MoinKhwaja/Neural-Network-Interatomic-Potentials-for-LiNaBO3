# Thermal conductivity via RNEMD (Muller-Plathe) at 600C (873K)
# B10O34C2Na15Li15, 2x2x5 supercell (1520 atoms)
# Trick: continuous NVT + RNEMD (no NVE windows). The Nose-Hoover
# thermostat continuously dissipates DeePMD's energy drift, preventing
# the runaway blow-ups seen in the windowed NVE/NVT setup at this
# composition (out of v4 training distribution at hot RNEMD slabs).
# Mirrors the original successful lean TC setup at
# production/old/thermal_conductivity_600C/input.lammps.

variable        TEMP equal 873.0
variable        PRES equal 1.0

plugin load /apps/t4/rhel9/free/deepmd-kit/2.2.9/gcc11.4.1/cuda12.3.2/openmpi5.0.2/lib/deepmd_lmp/dpplugin.so

units           metal
boundary        p p p
atom_style      atomic
neighbor        1.0 bin

box             tilt large
read_data       conf.lmp
replicate       2 2 5
change_box      all triclinic

pair_style      deepmd frozen_model.pb
pair_coeff      * *

velocity        all create ${TEMP} 45678
timestep        0.001

# --- Phase 1: NPT equilibration (100 ps) ---
fix             1 all npt temp ${TEMP} ${TEMP} 0.1 iso ${PRES} ${PRES} 0.5
thermo_style    custom step temp pe ke etotal press vol lx ly lz
thermo          1000
run             100000
unfix           1

# --- Phase 2: NVT equilibration (50 ps) ---
fix             1 all nvt temp ${TEMP} ${TEMP} 0.1
run             50000
unfix           1

# --- Phase 3: continuous NVT + RNEMD production (3 ns) ---
reset_timestep  0

# 20-slab temperature profile, ave/chunk: 1000-step blocks averaged 10 ways
compute         layers all chunk/atom bin/1d z lower 0.05 units reduced
fix             temp_profile all ave/chunk 10 1000 10000 layers temp file temp_profile.dat

# Continuous NVT thermostat keeps total kinetic energy bounded
fix             1 all nvt temp ${TEMP} ${TEMP} 0.1
# RNEMD energy swap: every 100 steps swap the 1 hottest atom in cold slab
# with the 1 coldest atom in hot slab; 20 slabs along z
fix             rnemd all thermal/conductivity 100 z 20

thermo_style    custom step temp pe ke etotal press f_rnemd
thermo          10000

run             3000000

print "Total energy transferred: $(f_rnemd)"
print "Production complete"
