&GLOBAL
  PROJECT aimd
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME aimd-1_12500.restart
&END EXT_RESTART

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME /home/3/uh03203/Documents/cp2k/data/BASIS_MOLOPT_UCL
    BASIS_SET_FILE_NAME /home/3/uh03203/Documents/cp2k/data/BASIS_MOLOPT
    BASIS_SET_FILE_NAME /home/3/uh03203/Documents/cp2k/data/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /home/3/uh03203/Documents/cp2k/data/GTH_POTENTIALS
    MULTIPLICITY 1

    &MGRID
      CUTOFF 800
      REL_CUTOFF 60
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200

      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 0.1
      &END OT

      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME /home/3/uh03203/Documents/cp2k/data/dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 15
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      A 9.2782530588 0.0 0.0
      B 0.0 9.2782530588 0.0
      C 0.0 0.0 9.2782530588
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME structure.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND Li
      ELEMENT Li
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE
    &END KIND

    &KIND Na
      ELEMENT Na
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND

    &KIND B
      ELEMENT B
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS

  &PRINT
    &FORCES ON
      FILENAME =forces
      &EACH
        MD 1
      &END EACH
    &END FORCES

    &STRESS_TENSOR ON
      &EACH
        MD 1
      &END EACH
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NPT_I
    STEPS 10000
    TIMESTEP 1
    TEMPERATURE 973.15

    &THERMOSTAT
      TYPE NOSE
      &NOSE
        TIMECON 50
        LENGTH 6
      &END NOSE
    &END THERMOSTAT

    &BAROSTAT
      PRESSURE 1.0
      TIMECON 500
    &END BAROSTAT
  &END MD

  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      FILENAME aimd.xyz
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY

    &VELOCITIES
      FILENAME aimd.vel
      &EACH
        MD 1
      &END EACH
    &END VELOCITIES

    &CELL
      FILENAME aimd.cell
      &EACH
        MD 1
      &END EACH
    &END CELL

    &RESTART
      FILENAME aimd.restart
      &EACH
        MD 1000
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION
